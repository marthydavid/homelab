{
  "extends": ["mergeConfidence:all-badges"],
  "semanticCommits": "enabled",
  "commitMessageTopic": "{{packageName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 25,
  "argocd": {
    "commitMessageTopic": "argocd chart {{depName}}",
    "fileMatch": [
      "(^|/)argocd/applicationsets/.+\\.yaml$"
    ]
  },
  "helm-values": {
    "commitMessageTopic": "helm values {{depName}}",
    "fileMatch": [
      "(^|/).*-values\\.yaml$",
      "(^|/).*\\.yaml$"
    ]
  },
  "packageRules": [
    {
      "description": "Hold external-dns: v0.23 rewrites target/alias A ALIAS records to plain A (issue #1908)",
      "matchPackageNames": ["external-dns"],
      "matchDatasources": ["helm"],
      "enabled": false
    },
    {
      "description": "Hold external-dns at chart 1.20.x until #1908 is solved (v0.23 rewrites ALIAS records to A)",
      "matchDatasources": ["helm"],
      "matchDepNames": ["external-dns"],
      "enabled": false
    },
    {
      "description": "Auto merge container digests",
      "matchDatasources": ["docker"],
      "automerge": true,
      "ignoreTests": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "matchPackagePatterns": ["ghcr.io/bjw-s", "ghcr.io/home-operations", "ghcr.io/scr", "ghcr.io/marthydavid"]
    },
    {
      "description": "Auto merge container digests",
      "matchDatasources": ["docker"],
      "automerge": true,
      "ignoreTests": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"]
    },
    {
      "description": "Auto merge helm deps",
      "matchDatasources": ["helm","git-tags"],
      "automerge": true,
      "ignoreTests": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"]
    },
    {
      "description": "Never automerge Vault (image or chart): with nas auto-sync a merge restarts the secrets root for both clusters, so bumps get a PR and a human (issue #2018)",
      "matchDepNames": ["hashicorp/vault", "vault"],
      "automerge": false
    }
  ]
}
